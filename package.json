{
  "name": "ott-platform",
  "version": "1.0.0",
  "description": "Web-based OTT streaming platform built with Node.js, Express.js, MongoDB, and vanilla JavaScript.",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:bulk": "node --env-file-if-exists=.env scripts/seed.js --bulk 50000",
    "loadtest": "node --env-file-if-exists=.env scripts/load-test.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
