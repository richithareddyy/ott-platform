NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/ott_platform
MONGO_POOL_SIZE=50
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
STREAM_TOKEN_TTL=2h
MEDIA_DIR=./media

# Accounts created by `npm run seed`
SEED_ADMIN_EMAIL=admin@streambox.test
SEED_ADMIN_PASSWORD=change-me-admin
SEED_USER_EMAIL=viewer@streambox.test
SEED_USER_PASSWORD=change-me-viewer

# Separate database used by `npm test` (it is wiped between tests)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/ott_platform_test
